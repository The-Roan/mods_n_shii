{
  "format_version": "1.21.100",
  "minecraft:block": {
    "description": {
      "identifier": "shitrooms:void_glass",
      "menu_category": { "category": "construction" },
      "states": {
        "shitrooms:facing": [0, 1, 2, 3, 4, 5]
      }
    },
    "components": {
      "minecraft:destructible_by_mining": false,
      "minecraft:destructible_by_explosion": false,
      "minecraft:light_emission": 15,
      "minecraft:geometry": "geometry.void_glass",
      "minecraft:collision_box": {
        "origin": [-8, 0, -8],
        "size": [16, 16, 16]
      },
      "minecraft:selection_box": {
        "origin": [-8, 0, -8],
        "size": [16, 16, 16]
      },
      "minecraft:material_instances": {
        "sky": {
          "texture": "void_glass",
          "render_method": "alpha_test",
          "face_dimming": false,
          "ambient_occlusion": false
        },
        "drywall": {
          "texture": "drywall",
          "render_method": "opaque",
          "face_dimming": true,
          "ambient_occlusion": true
        },
        "*": {
          "texture": "void_glass",
          "render_method": "alpha_test",
          "face_dimming": false,
          "ambient_occlusion": false
        }
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('shitrooms:facing') == 0",
        "components": { "minecraft:transformation": { "rotation": [180, 0, 0] } }
      },
      {
        "condition": "q.block_state('shitrooms:facing') == 1",
        "components": { "minecraft:transformation": { "rotation": [0, 0, 0] } }
      },
      {
        "condition": "q.block_state('shitrooms:facing') == 2",
        "components": { "minecraft:transformation": { "rotation": [90, 0, 0] } }
      },
      {
        "condition": "q.block_state('shitrooms:facing') == 3",
        "components": { "minecraft:transformation": { "rotation": [-90, 0, 0] } }
      },
      {
        "condition": "q.block_state('shitrooms:facing') == 4",
        "components": { "minecraft:transformation": { "rotation": [0, 0, 90] } }
      },
      {
        "condition": "q.block_state('shitrooms:facing') == 5",
        "components": { "minecraft:transformation": { "rotation": [0, 0, -90] } }
      }
    ]
  }
}
