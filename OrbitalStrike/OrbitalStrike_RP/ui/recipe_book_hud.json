  // ─── Root container injected into hud_content ─────────────────────────────
  "recipe_book_overlay": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "orbital@orbital_recipe_book.orbital_panel": {} },
      { "ddx@orbital_recipe_book.ddx_panel": {} },
      { "instant@orbital_recipe_book.instant_panel": {} },
      { "big@orbital_recipe_book.big_panel": {} },
