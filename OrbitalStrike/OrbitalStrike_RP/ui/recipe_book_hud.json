{
  "namespace": "orbital_recipe_book",

  // ─── Shared background overlay ─────────────────────────────────────────────
  // Full-screen semi-transparent dark panel used by every recipe page.
  "overlay_bg": {
    "type": "image",
    "texture": "textures/ui/Black",
    "fill": true,
    "alpha": 0.82,
    "size": [ "100%", "100%" ],
    "layer": 25
  },

  // ─── Shared content frame ──────────────────────────────────────────────────
  // Centred card that holds the recipe image, ingredients and close hint.
  // $recipe_title, $recipe_color, $recipe_texture and $ingredient_* must be
  // supplied by each recipe control that extends this template.
  "recipe_card": {
    "type": "panel",
    "size": [ 220, 260 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 26,
    "controls": [
      {
        "card_bg": {
          "type": "image",
          "texture": "textures/ui/dialog_background_opaque",
          "size": [ "100%", "100%" ],
          "alpha": 0.95
        }
      },
      {
        "title_label": {
          "type": "label",
          "text": "$recipe_title",
          "color": "$recipe_color",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 8 ],
          "shadow": true
        }
      },
      {
        "recipe_image": {
          "type": "image",
          "texture": "$recipe_texture",
          "size": [ 128, 128 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 26 ]
        }
      },
      {
        "ingredients_panel": {
          "type": "stack_panel",
          "orientation": "vertical",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 12, 162 ],
          "size": [ "100%-24px", "default" ],
          "controls": [
            {
              "sep": {
                "type": "label",
                "text": "§8Ingredients:",
                "offset": [ 0, 0 ]
              }
            },
            { "i1": { "type": "label", "text": "$ingredient_1", "color": [ 0.9, 0.9, 0.9 ] } },
            { "i2": { "type": "label", "text": "$ingredient_2", "color": [ 0.9, 0.9, 0.9 ] } },
            { "i3": { "type": "label", "text": "$ingredient_3", "color": [ 0.9, 0.9, 0.9 ] } },
            { "i4": { "type": "label", "text": "$ingredient_4", "color": [ 0.9, 0.9, 0.9 ] } },
            { "i5": { "type": "label", "text": "$ingredient_5", "color": [ 0.9, 0.9, 0.9 ] } },
            { "i6": { "type": "label", "text": "$ingredient_6", "color": [ 0.9, 0.9, 0.9 ] } }
          ]
        }
      },
      {
        "close_hint": {
          "type": "label",
          "text": "§7Use book again to close",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [ 0, -6 ],
          "shadow": false
        }
      }
    ]
  },

  // ─── Helper: empty ingredient placeholder ─────────────────────────────────
  // Used when a recipe has fewer than 6 ingredient lines.
  "$empty": " ",

  // ─── Recipe panels (one per strike) ───────────────────────────────────────
  // Each panel checks #hud_actionbar_text_string for its unique §0rb_N signal.
  // The §0 (black) prefix makes the signal nearly invisible in the action bar.

  "orbital_panel": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 25,
    "controls": [
      { "bg@orbital_recipe_book.overlay_bg": {} },
      {
        "card@orbital_recipe_book.recipe_card": {
          "$recipe_title": "Orbital Strike Beacon",
          "$recipe_color": [ 0.85, 0.15, 0.15 ],
          "$recipe_texture": "textures/items/recipe_detail_orbital",
          "$ingredient_1": "• End Crystal  ×6",
          "$ingredient_2": "• Nether Star  ×2",
          "$ingredient_3": "• Beacon  ×1",
          "$ingredient_4": " ",
          "$ingredient_5": " ",
          "$ingredient_6": " "
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "(#hud_actionbar_text_string = '§0rb_1')",
        "binding_name_override": "#visible",
        "binding_type": "global",
        "binding_condition": "always"
      }
    ]
  },

