{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "orbital:eoi_pink_glow",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particles/singularity_circle"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 8 },
      "minecraft:emitter_lifetime_once": { "active_time": 0 },
      "minecraft:emitter_shape_sphere": { "radius": 0.4, "direction": "outward" },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "Math.random(0.4, 0.9)" },
      "minecraft:particle_initial_speed": "Math.random(0.1, 0.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 2.2, 0],
        "linear_drag_coefficient": 3.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["Math.random(0.4, 1.1)", "Math.random(0.4, 1.1)"],
        "facing_camera_type": "rotate_xyz",
        "uv": { "texture_width": 32, "texture_height": 32, "uv": [0, 0], "uv_size": [32, 32] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0":  [1.0, 0.2, 0.6, 0.0],
            "0.07": [1.0, 0.25, 0.65, 1.0],
            "0.3":  [1.0, 0.35, 0.2, 1.0],
            "0.65": [0.9, 0.1, 0.1, 0.7],
            "1.0":  [0.6, 0.0, 0.05, 0.0]
