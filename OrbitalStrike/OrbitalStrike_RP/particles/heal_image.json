      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0":  [1.0, 0.5, 0.8, 1.0],
            "0.4":  [1.0, 0.4, 0.7, 0.9],
            "0.8":  [0.8, 0.2, 0.5, 0.4],
            "1.0":  [0.5, 0.1, 0.3, 0.0]
