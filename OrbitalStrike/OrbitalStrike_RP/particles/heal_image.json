{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "orbital:heal_image",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/heal_strike_image"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 18 },
      "minecraft:emitter_lifetime_once": { "active_time": 0 },
      "minecraft:emitter_shape_sphere": { "radius": 7.0, "direction": "outward" },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "Math.random(1.5, 3.5)" },
