      "minecraft:particle_appearance_billboard": {
        "size": ["Math.random(2.0, 4.0)", "Math.random(2.0, 4.0)"],
        "facing_camera_type": "rotate_xyz",
        "uv": { "texture_width": 64, "texture_height": 64, "uv": [0, 0], "uv_size": [64, 64] }
