{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "orbital:eoi_white_glow",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particles/singularity_circle"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 10 },
      "minecraft:emitter_lifetime_once": { "active_time": 0 },
      "minecraft:emitter_shape_sphere": { "radius": 0.5, "direction": "outward" },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "Math.random(0.5, 1.2)" },
      "minecraft:particle_initial_speed": "Math.random(0.05, 0.4)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 0, 0],
        "linear_drag_coefficient": 8.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["Math.random(1.0, 3.0)", "Math.random(1.0, 3.0)"],
        "facing_camera_type": "rotate_xyz",
        "uv": { "texture_width": 32, "texture_height": 32, "uv": [0, 0], "uv_size": [32, 32] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0":  [1.0, 1.0, 1.0, 0.0],
            "0.05": [1.0, 1.0, 1.0, 1.0],
            "0.3":  [0.95, 0.9, 1.0, 1.0],
            "0.7":  [0.85, 0.85, 1.0, 0.7],
            "1.0":  [1.0, 1.0, 1.0, 0.0]
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
