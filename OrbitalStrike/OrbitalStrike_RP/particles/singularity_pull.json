{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "orbital:singularity_pull",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particles/singularity_circle"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 20 },
      "minecraft:emitter_lifetime_once": { "active_time": 0 },
      "minecraft:emitter_shape_sphere": { "radius": 12.0, "direction": "inward" },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "Math.random(0.5, 1.0)" },
      "minecraft:particle_initial_speed": "Math.random(8.0, 16.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 0, 0],
        "linear_drag_coefficient": 0.3
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["Math.random(0.15, 0.5)", "Math.random(0.15, 0.5)"],
        "facing_camera_type": "rotate_xyz",
        "uv": { "texture_width": 32, "texture_height": 32, "uv": [0, 0], "uv_size": [32, 32] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0":  [1.0,  0.95, 1.0,  0.0],
            "0.1":  [1.0,  0.95, 1.0,  1.0],
            "0.5":  [0.85, 0.7,  1.0,  0.9],
            "0.85": [0.55, 0.3,  0.9,  0.5],
            "1.0":  [0.2,  0.0,  0.6,  0.0]
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
